# .env.server.example — Server deployment environment template
#
# Copy to .env before running docker compose -f docker-compose.server.yml up:
#   cp .env.server.example .env
#   # Edit the required fields below
#
# Required fields are marked [REQUIRED]. Defaults are server-appropriate.
# Never commit a filled-in .env to version control.

# ── Authentication ────────────────────────────────────────────────────────────

# [REQUIRED] Neo4j password. Must not be empty or "changeme".
# Generate: openssl rand -base64 32
NEO4J_PASSWORD=

# [REQUIRED] OpenAI API key (used by palace-mcp for embeddings fallback).
OPENAI_API_KEY=

# ── Repo mounts ───────────────────────────────────────────────────────────────

# [REQUIRED] Parent directory on the host containing checked-out repos.
# All repos live as subdirectories: $PALACE_REPO_PARENT/gimle, /uw-ios, etc.
# Ownership: dirs must be readable by UID 1000 (chmod o+rX or chown -R 1000:1000).
PALACE_REPO_PARENT=/srv/repos

# ── Neo4j memory (tune to host RAM) ──────────────────────────────────────────

# Recommended for 32 GB host: heap 8G, pagecache 8G (total ~16G Neo4j footprint).
# Recommended for 64 GB host: heap 16G, pagecache 16G.
NEO4J_HEAP_INITIAL=4G
NEO4J_HEAP_MAX=8G
NEO4J_PAGECACHE=4G
NEO4J_MEM_LIMIT=16g
NEO4J_CPUS=4.0

# ── palace-mcp resources ─────────────────────────────────────────────────────

PALACE_MEM_LIMIT=4g
PALACE_CPUS=2.0

# ── palace-mcp port (host-side binding) ──────────────────────────────────────

# Default: loopback only (127.0.0.1:8080). Change PALACE_MCP_HOST to 0.0.0.0
# only if a reverse proxy handles TLS termination and access control.
PALACE_MCP_HOST=127.0.0.1
PALACE_MCP_PORT=8080

# ── Model cache ───────────────────────────────────────────────────────────────

# Host path for Qodo-Embed-1-1.5B model weights (~3 GB).
# Survives container rebuilds; shared across palace-mcp instances.
# Must be owned by UID 1000 (appuser): chown -R 1000:1000 /data/palace-model-cache
PALACE_HF_CACHE_DIR=/data/hf-cache

# Enable local-only model loading — fail fast if cache absent/stale/readonly.
# Set to 1 after running: docker compose -f docker-compose.server.yml --profile cache-warm run cache-warm
PALACE_EMBEDDING_LOCAL_ONLY=1

# ── Git SHA (optional, injected at build time) ────────────────────────────────

PALACE_GIT_SHA=unknown

# ── Codebase-memory MCP (optional code-graph profile) ────────────────────────

# Leave empty to disable palace.code.* tools.
# Set to /usr/local/bin/codebase-memory-mcp to enable.
CODEBASE_MEMORY_MCP_BINARY=

# ── SCIP index paths (optional) ───────────────────────────────────────────────

# JSON map of project slug → in-container SCIP index path.
# Paths must be inside a bind-mounted /repos/<slug> directory.
# Example (all projects):
# PALACE_SCIP_INDEX_PATHS={"gimle":"/repos/gimle/scip/index.scip","uw-ios":"/repos/uw-ios/scip/index.scip","uw-android":"/repos/uw-android/scip/index.scip"}
PALACE_SCIP_INDEX_PATHS=

# ── Ops integration (optional) ────────────────────────────────────────────────

# Set PALACE_OPS_HOST=local when palace-mcp and paperclip run on the same host.
# Otherwise: SSH hostname, and set PALACE_OPS_SSH_USER / PALACE_OPS_SSH_KEY.
PALACE_OPS_HOST=local
PALACE_OPS_SSH_USER=
PALACE_OPS_SSH_KEY=

# Paperclip API URL reachable from inside the container.
PALACE_PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=

# ── ADR directory ─────────────────────────────────────────────────────────────

PALACE_ADR_BASE_DIR=/var/lib/palace/adr
